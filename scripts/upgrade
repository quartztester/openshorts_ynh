#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SERVICES (node_modules and venv are about to be replaced)
#=================================================

ynh_systemctl --service="$app" --action=stop
ynh_systemctl --service="$app-render" --action=stop

openshorts_store_llm_settings

#=================================================
# DOWNLOAD AND UNPACK SOURCE
#=================================================

ynh_script_progression "Upgrading source files..."

# venv/, node_modules trees and the built dashboard are reproducible, not
# user data: wipe and rebuild them, keep everything else (--keep).
ynh_setup_source --dest_dir="$install_dir" --keep="venv dashboard/node_modules render-service/node_modules remotion/node_modules env output uploads requirements-cpu.txt"

# Symlinks into data_dir may not survive the source swap.
openshorts_link_data

#=================================================
# DEPENDENCIES AND BUILD
#=================================================

openshorts_ensure_venv
openshorts_pip_install_deps
openshorts_apply_patches
openshorts_build_frontends
# No YOLO refetch: present since install, rebuilt only if upstream bumps it.
openshorts_preload_models no

#=================================================
# CONFIG (re-render from the new package's templates)
#=================================================

ynh_script_progression "Adding system configuration..."
openshorts_add_config

ynh_script_progression "Restarting OpenShorts services..."
openshorts_start_services
openshorts_set_logo

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
