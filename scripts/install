#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# OpenShorts' dashboard and backend speak absolute paths (/api, /videos...),
# so a subpath install half-works. Refuse it here, the path everyone takes.
if [ "${path:-/}" != "/" ]; then
	ynh_die "OpenShorts must be installed at the root of a domain (path=/): the app uses absolute URLs internally."
fi

openshorts_store_llm_settings

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"
openshorts_link_data

#=================================================
# DEPENDENCIES AND BUILD
#=================================================

openshorts_ensure_venv
openshorts_pip_install_deps
openshorts_apply_patches
openshorts_build_frontends
openshorts_preload_models yes

#=================================================
# SYSTEM CONFIGURATION AND START
#=================================================

ynh_script_progression "Adding app configuration..."
openshorts_add_config

ynh_script_progression "Starting OpenShorts services..."
openshorts_start_services
openshorts_set_logo

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
