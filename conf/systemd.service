[Unit]
Description=OpenShorts backend (__APP__)
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/env
# A first job loads torch + whisper + yolov8 concurrently: give startup and
# stop generous bounds.
TimeoutStartSec=300
TimeoutStopSec=60
# OOM guard: faster-whisper whole-audio feature extraction could balloon a
# job to 7-9 GB on multi-hour uploads and the kernel's global OOM killer
# took down neighboring services (once MariaDB) with it. The bundled patch
# span-chunks long audio (patches/main.patch), keeping a job ~2.5 GB; this
# cap makes any future regression kill the job, not the server.
MemoryMax=10G
MemoryHigh=7G
MemorySwapMax=4G
ExecStart=__INSTALL_DIR__/venv/bin/uvicorn app:app --host 127.0.0.1 --port __PORT__ --proxy-headers --forwarded-allow-ips "*" --timeout-graceful-shutdown 15
 NoNewPrivileges=yes
 PrivateTmp=yes
 ProtectSystem=full
 # NB: no ProtectHome — the YunoHost data_dir lives under /home/yunohost.app,
 # and uploads/output symlink into it.
 ProtectKernelTunables=yes
 ProtectKernelModules=yes
 ProtectControlGroups=yes
 RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
 RestrictNamespaces=yes
 LockPersonality=yes
 MemoryDenyWriteExecute=no
 SystemCallFilter=@system-service
 SystemCallErrorNumber=EPERM
 Restart=on-failure
 RestartSec=5

[Install]
WantedBy=multi-user.target
