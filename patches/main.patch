         return _run_whisper_once(media_path, **params)
 
 
+def _probe_duration(path):
+    """Duration in seconds via ffprobe, or None when it cannot be read."""
+    try:
+        out = subprocess.run(
+            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
