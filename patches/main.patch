+# --- long-audio chunking (OOM fix, 09-oct-2026) ------------------------------
+# faster-whisper's classic WhisperModel.transcribe() computes the log-Mel
+# spectrogram of the WHOLE VAD-filtered audio in one call: for a 2h28m source
+# that materialises several multi-GB STFT/mel temporaries at once (windowed
+# frames, complex FFT, magnitudes, mel matmul) on top of the decoded audio
+# and its np.concatenate copy, peaking at 7-9 GB — the kernel OOM-killed
+# openshorts.service on exactly that (10 kills in 14 days; MariaDB was once
+# collateral). Upstream batches VAD but not the feature extraction on this
+# path, so the app slices long sources itself: cut at VAD silence gaps into
+# spans of at most TRANSCRIBE_SPAN_MINUTES, transcribe each span with the
+# same params, shift the timestamps by the span offset, and concatenate.
+# Output contract is unchanged; memory stays flat regardless of duration.
+TRANSCRIBE_SPAN_MINUTES = int(os.environ.get("TRANSCRIBE_SPAN_MINUTES", "20"))
+# Reuse the VAD the model itself would run: cutting at silence boundaries
+# means every span starts on speech, so no word is ever split mid-utterance.
+_SPAN_MAX_SECONDS = TRANSCRIBE_SPAN_MINUTES * 60
+
+
+def _transcribe_spans(audio, model, **params):
+    """Whisper segments for a long 1D float32 16 kHz array, span by span.
+
+    Returns (segments, language). Timestamps are shifted to be absolute
+    (whole-file) so downstream consumers see one continuous transcript.
+    """
+    import numpy as np
+    from faster_whisper.vad import get_speech_timestamps, VadOptions
+
+    total = float(audio.shape[0]) / 16000.0
+    if total <= _SPAN_MAX_SECONDS:
+        segments, info = model.transcribe(audio, **params)
+        return list(segments), getattr(info, "language", None)
+
+    # Speech spans (sample indices). The same Silero VAD the model would run
+    # internally, run once here to find cut points instead of filtering.
+    speech = get_speech_timestamps(audio, VadOptions())
+    if not speech:
+        segments, info = model.transcribe(audio, **params)
+        return list(segments), getattr(info, "language", None)
+
+    # Greedy packer: accumulate speech chunks into a span until it would
+    # exceed the cap, then close the span at the chunk boundary (a silence
+    # gap), never inside an utterance.
+    rate = 16000
+    spans = []          # list of (start_sample, end_sample)
+    cur_start, cur_end = None, None
+    for ch in speech:
+        s, e = ch["start"], ch["end"]
+        if cur_start is None:
+            cur_start, cur_end = s, e
+        elif (e - cur_start) / rate > _SPAN_MAX_SECONDS:
+            spans.append((cur_start, cur_end))
+            cur_start, cur_end = s, e
+        else:
+            cur_end = e
+    if cur_start is not None:
+        spans.append((cur_start, cur_end))
+
+    all_segments = []
+    language = None
+    progress = _TranscribeProgress(total)
+    for span_start, span_end in spans:
+        span_audio = audio[span_start:span_end]
+        span_params = dict(params, clip_timestamps="0")
+        # Pin the language after the first span: the whole-file path detects
+        # it once (first 30 s), so a later span heavy in foreign speech must
+        # not silently switch languages mid-transcript.
+        if language is not None:
+            span_params["language"] = language
+        segments, info = model.transcribe(span_audio, **span_params)
+        if language is None:
+            language = getattr(info, "language", None)
+        offset = span_start / rate
+        for segment in segments:
+            segment.start += offset
+            segment.end += offset
+            if segment.words:
+                for w in segment.words:
+                    w.start += offset
+                    w.end += offset
+            all_segments.append(segment)
+            progress.update(segment.end)
+    progress.update(progress.total)
+    return all_segments, language
+
+
